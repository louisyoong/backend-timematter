# ─────────────────────────────────────────────────────────────────────────────
# TimeMatter Backend — Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_anon_public_key_here
# Found in: Supabase Dashboard → Settings → API → service_role (secret ⚠️)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL used in password reset links
# Local: http://localhost:3000  |  Production: https://yourdomain.com
APP_URL=http://localhost:3000

# ── Email — Resend (https://resend.com) ───────────────────────────────────────
# 1. Sign up at resend.com → create an API key
# 2. Local testing: leave RESEND_FROM as onboarding@resend.dev (no domain needed)
#    Emails only deliver to your Resend account email on the free plan
# 3. Production: verify your domain and change RESEND_FROM to your own address
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=TimeMatter <onboarding@resend.dev>